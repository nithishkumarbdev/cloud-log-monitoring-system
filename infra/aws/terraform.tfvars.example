# Copy this file to terraform.tfvars and fill in your own values.
# terraform.tfvars is gitignored, never commit real values.

aws_region   = "us-east-1"
project_name = "cloud-log-monitor"

alert_email = "you@example.com"

# Restrict this to your own IP, e.g. "203.0.113.4/32". Find yours with
# `curl -s ifconfig.me`. Never leave this as 0.0.0.0/0.
ssh_ingress_cidr = "YOUR_IP/32"

ip_allowlist            = ""
brute_force_threshold   = 5
traffic_spike_baseline  = 20
poll_window_minutes     = 5

# Leave blank to skip the Slack subscriber entirely.
slack_webhook_url = ""
